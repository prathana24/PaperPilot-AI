# PaperPilot-AI Environment Configuration Template
# Copy this file to .env and insert your personal Google Gemini API key

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Active Supported Gemini Model (Default: gemini-3.8-flash)
# Options:
# - gemini-3.8-flash (Recommended default: High intelligence, long-horizon agents)
# - gemini-3.5-flash-lite (Cost-efficient, high-speed alternative)
# - gemini-3.1-pro (Frontier reasoning)
GEMINI_MODEL=gemini-3.8-flash
